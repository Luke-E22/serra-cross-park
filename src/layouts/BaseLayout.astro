---
// Global CSS, in this order: tokens, then the component bundle (its digit-only font faces
// must follow the full faces), then site styles.
import '../../design-system/tokens.css';
import '../styles/fonts.css';
import '../../design-system/components/bundle.css';
import '../styles/site.css';
import strongGlasgowBold from '../../design-system/fonts/StrongGlasgow-Bold.ttf?url';
import { SiteFooter } from '../components/ds';
import SiteHeaderIsland from '../components/SiteHeaderIsland';
import { CREDIT, FOOTER_COLUMNS, SITE } from '../config/site';
import { ogImage as buildOgImage } from '../lib/images';
import ogFallbackPhoto from '../assets/photos/cross-olive-panorama.jpg';

interface Props {
  /** Page title. Rendered as "<title> | Serra Cross Park" unless titleSuffix is false. */
  title: string;
  description: string;
  /** Site path for the canonical URL, for example "/about/". A trailing slash is added. */
  path: string;
  /** Open Graph image: an absolute URL or a site-relative path. Pages make one with ogImage() from src/lib/images; without it, a 1200x630 crop of the olive panorama. */
  ogImage?: string;
  /** What is in the Open Graph image, for og:image:alt and twitter:image:alt. */
  ogImageAlt?: string;
  /** The header link to mark as current, by label. */
  active?: string;
  /** True when the page renders its own hero that carries the header. */
  hero?: boolean;
  /** False when `title` is already the full document title (Home). */
  titleSuffix?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  ogImageAlt = 'The Cross at Serra Cross Park above Ventura',
  active,
  hero = false,
  titleSuffix = true,
} = Astro.props;

const pageTitle = titleSuffix ? `${title} | ${SITE.name}` : title;
const normalizedPath = ('/' + path.replace(/^\/+/, '')).replace(/\/?$/, '/');
const canonical = new URL(normalizedPath, SITE.url).href;
// Every page gets a card image. A page passes its own crop as ogImage; the rest share the panorama.
const ogImageUrl = new URL(ogImage ?? (await buildOgImage(ogFallbackPhoto)), SITE.url).href;

// Site-wide structured data: the Conservancy and the park. Pages add their own nodes (FAQPage,
// EventVenue) through the head slot and point at these two by @id.
const ORG_ID = `${SITE.url}#org`;
const PARK_ID = `${SITE.url}#park`;
const homeUrl = new URL('/', SITE.url).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NGO',
      '@id': ORG_ID,
      name: SITE.org,
      url: homeUrl,
      email: SITE.email,
      taxID: SITE.ein,
      nonprofitStatus: 'Nonprofit501c3',
      address: {
        '@type': 'PostalAddress',
        postOfficeBoxNumber: '48',
        addressLocality: 'Ventura',
        addressRegion: 'CA',
        postalCode: '93002-0048',
        addressCountry: 'US',
      },
      sameAs: [SITE.facebook],
    },
    {
      '@type': 'TouristAttraction',
      '@id': PARK_ID,
      name: SITE.name,
      url: homeUrl,
      description:
        'A one-acre hilltop park around the Cross, above Mission San Buenaventura in Grant Park, Ventura, with views of the Pacific and the Channel Islands.',
      geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
      address: { '@type': 'PostalAddress', addressLocality: 'Ventura', addressRegion: 'CA', addressCountry: 'US' },
      isAccessibleForFree: true,
      publicAccess: true,
      image: ogImageUrl,
      maintainer: { '@id': ORG_ID },
    },
  ],
};
// "<" is escaped so no string in the data can close the script element early.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Google Search Console: the old site's verification tag, carried over so the property stays verified. */}
    <meta name="google-site-verification" content="A-x5km0fMWxUOoZC8MGXWaXg5TPJSZ1A3ulxehcSjS8" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1d2944" />
    <link rel="preload" href={strongGlasgowBold} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/eb-garamond/eb-garamond-normal-400-600-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link label" href="#main">Skip to content</a>
    {!hero && <SiteHeaderIsland client:media="(max-width: 1099px)" active={active} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter
      columns={FOOTER_COLUMNS}
      ein={SITE.ein}
      email={SITE.email}
      location={SITE.location}
      facebookHref={SITE.facebook}
      credit={CREDIT}
      year={2026}
    />
  </body>
</html>
