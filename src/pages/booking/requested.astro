---
import '../../styles/pages/booking-requested.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Button, SectionHeading, Steps } from '../../components/ds';
import { SITE } from '../../config/site';
import { ogImage } from '../../lib/images';

import { PHOTOS } from '../../content/photos';

// Cal.com sends people here after they book (its success redirect, set by Luke; see
// docs/INTEGRATION-NOTES.md). The page is noindex because nobody should land on it from search.
// The rules come from docs/TERMS-SOURCE.md (2026-10-12), clauses 1.1 to 1.3: the full payment
// comes with the reservation, the reservation is confirmed once the payment is processed, the
// payment is non-refundable, and the date can move once at no charge, subject to availability,
// by email. Nothing here links to a payment form; the fee is collected with the reservation.
// The 501(c)(3) line stays in the footer, as on every page. This page makes no claim either way about
// the tax treatment of the fee (CONTENT-TODO item 2); the booking page carries the board's sentence.
// [CONFIRM: item 5, whether these steps should name Amber Weir or keep "the park office"]

const ogPhoto = PHOTOS['reception-lawn'];
const og = await ogImage(ogPhoto.image);

const steps = [
  { title: 'We check the date and your details', text: 'The park office reviews your request and makes sure the date and time work.' },
  { title: 'Your payment is processed', text: 'The site fee is collected with your reservation. It is non-refundable.' },
  { title: 'We confirm by email', text: 'Once the payment is processed, the park office emails your confirmation. Your date is reserved.' },
  {
    title: 'Reschedule once for free if you need to',
    text: `Subject to availability. Email the park office at ${SITE.email} with the new date and time.`,
  },
];
---

<BaseLayout
  title="Booking requested"
  description="We have your request for a date at Serra Cross Park. Here is what happens next."
  path="/booking/requested/"
  ogImage={og}
  ogImageAlt={ogPhoto.alt}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="sc-section">
    <div class="sc-container">
      <SectionHeading
        as="h1"
        title="We have your request"
        intro="Thank you. The park office will confirm your reservation by email. Here is what happens next."
      />
      <div class="requested__steps">
        {/* Steps renders h3 titles, so a hidden h2 keeps the heading order without a visible repeat of the intro. */}
        <h2 class="sc-visually-hidden">What happens next</h2>
        <Steps tone="light" steps={steps} />
      </div>
    </div>
  </section>

  <section class="sc-section sc-section--alt">
    <div class="sc-container">
      <div class="requested-next body">
        {/* One line on purpose: a source line break before the <a> is collapsed to nothing, not a space. */}
        <p>Questions about your request? Email the park office at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
        <div class="requested-next__actions">
          <Button variant="secondary" href="/">Back to the park</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
